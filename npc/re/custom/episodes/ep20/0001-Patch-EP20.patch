diff --git a/src/custom/script.inc b/src/custom/script.inc
index 839b990cb..92b52d16c 100644
--- a/src/custom/script.inc
+++ b/src/custom/script.inc
@@ -17,3 +17,23 @@
 //	script_pushint(st,1);
 //	return 0;
 //}
+
+BUILDIN_FUNC(specialeffect3)
+{
+	int type = script_getnum(st, 2);
+	enum send_target target = script_hasdata(st, 3) ? (send_target)script_getnum(st, 3) : AREA;
+
+	struct block_list* bl;
+
+	if (!script_rid2bl(4, bl))
+		return SCRIPT_CMD_SUCCESS;
+
+	if( type <= EF_NONE || type >= EF_MAX ){
+		ShowError( "buildin_specialeffect3: unsupported effect id %d.\n", type );
+		return SCRIPT_CMD_FAILURE;
+	}
+
+	clif_specialeffect(bl, type, target);
+
+	return SCRIPT_CMD_SUCCESS;
+}
